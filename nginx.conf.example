# 中文：HTTPS 由本机 Nginx 终结；修改域名、证书路径和上游端口。
# English: Nginx terminates HTTPS here; replace the domain, certificates and upstream port.
server {
    listen 80;
    server_name mail.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name mail.example.com;

    ssl_certificate /etc/letsencrypt/live/mail.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mail.example.com/privkey.pem;
    client_max_body_size 8m;

    # 中文：统一代理页面、API、SSE 和 MCP，避免不同 location 漏传请求头。
    # English: Proxy UI, API, SSE and MCP together so all routes receive the same headers.
    location / {
        proxy_pass http://127.0.0.1:18085;
        proxy_http_version 1.1;

        # 中文：保留浏览器的 Host（含自定义端口），否则可能触发 invalid origin。
        # English: Preserve the browser's Host, including its port, for origin validation.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";

        # 中文：流式更新、正文和附件不使用 Nginx 缓冲或缓存。
        # English: Stream updates, bodies and attachments without proxy buffering or caching.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }
}
