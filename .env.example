# ==========================================
# MeldMail 环境变量配置
# ==========================================

# HTTP 监听地址（容器内保持 :8080 即可，由宿主机 Nginx 反代）
MELDMAIL_ADDR=:8080

# SQLite 数据库文件路径（容器内挂载路径）
MELDMAIL_DB_PATH=/data/meldmail.db

# 32 字节（64 位 Hex）主加密密钥，用于 AES-256-GCM 加密邮箱授权码与代理密码
# 生成命令：openssl rand -hex 32
MELDMAIL_MASTER_KEY=

# Web 端管理员初始密码（首次启动后自动转为 bcrypt 哈希存入数据库）
MELDMAIL_ADMIN_PASSWORD=change_me_to_a_strong_password

# 是否信任反向代理（Nginx）传来的 X-Forwarded-Proto 头
MELDMAIL_TRUST_PROXY=true
